{
  "keybindings": {
    "All": {
      "q": "Quit", // Quit the application
      "<Ctrl-z>": "Suspend", // Suspend the application
      "<tab>": "NextFocus", // Next focus
      "<down>": "Down", // Down
      "<up>": "Up", // Up
      "i":    {"EditorMode": "Insert"},
      "<esc>": {"EditorMode": "Normal"},

    },
    "Services": {
      "<enter>": "GetService" // Get service selected
    },
    "Objects": {
      "<enter>": "InvokeDbus", // Invoke the dbus method/property/signal
      "<right>": "DownTree",
      "<left>": "UpTree"
    },
    "Call": {
      "<enter>": "CallActiveMethod" // Call the ongoing method in the call view
    }
  }
}